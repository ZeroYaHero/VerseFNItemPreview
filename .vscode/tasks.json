// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "debug build",
			"dependsOn": ["publish backend", "npm: watch"],
			"dependsOrder": "sequence",
			"problemMatcher": []
		},
		{
			"label": "publish backend",
			"type": "npm",
			"script": "publish:backend",
			"problemMatcher": "$msCompile"
		},
		{
			"type": "npm",
			"script": "watch",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		}
	]
}
